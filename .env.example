# EffortlessInsight AI Service - Environment Variables Template
# Copy this file to .env and fill in the values for your environment
# NEVER commit .env files with real secrets to version control

# =============================================================================
# APPLICATION
# =============================================================================
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# =============================================================================
# DATABASE (PostgreSQL with pgvector)
# =============================================================================
DATABASE_URL=postgresql://postgres:password@localhost:5432/effortlessinsight_ai

# =============================================================================
# REDIS CACHE
# =============================================================================
REDIS_URL=redis://localhost:6379

# =============================================================================
# OPENAI
# =============================================================================
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# =============================================================================
# GOOGLE CLOUD (Document AI)
# =============================================================================
GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json
GOOGLE_PROJECT_ID=your-project-id
GOOGLE_LOCATION=us
GOOGLE_PROCESSOR_ID=your-processor-id

# =============================================================================
# AZURE (Form Recognizer - Fallback OCR)
# =============================================================================
AZURE_FORM_RECOGNIZER_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_FORM_RECOGNIZER_KEY=your-azure-key

# =============================================================================
# API SECURITY
# =============================================================================
API_KEY=your-internal-api-key

# =============================================================================
# ERROR TRACKING (Sentry)
# =============================================================================
SENTRY_DSN=

# =============================================================================
# PERFORMANCE
# =============================================================================
MAX_WORKERS=4
PROCESSING_TIMEOUT_SECONDS=90
OCR_CONFIDENCE_THRESHOLD=0.7

# =============================================================================
# STORAGE (for temporary files)
# =============================================================================
TEMP_STORAGE_PATH=/tmp/effortlessinsight
MAX_FILE_SIZE_MB=25

# =============================================================================
# RATE LIMITING & USAGE CAPS (protect OpenAI spend on cost endpoints)
# =============================================================================
# Short-term burst limit per organization on /process and /embeddings POSTs.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60
# If Redis (the counter store) is down, allow requests through rather than
# failing them. The absolute monthly ceiling below is the backstop.
RATE_LIMIT_FAIL_OPEN=true
# Per-plan monthly BACKSTOP cap on cost-incurring AI requests per org. The .NET
# API is the authoritative per-plan gate (it blocks by monthly notice count
# before calling this service) and sends X-Organization-Id + X-Plan headers;
# these caps are ~5x the notice quota to leave headroom for the several AI calls
# one notice triggers. Override with a JSON object; 0 = unlimited.
USAGE_CAPS_ENABLED=true
# PLAN_MONTHLY_REQUEST_CAPS={"free":50,"starter":250,"professional":1000,"enterprise":0,"default":50}
USAGE_GLOBAL_ORG_MONTHLY_CAP=5000
